pipeline { 
    agent any 
    stages { 
        stage('Verify Application Files') { 
            steps { 
                echo 'Verifying project files...' 
                script {
                    if (!fileExists('index.html')) {
                        error('index.html is missing!')
                    } else {
                        echo 'index.html Found'
                    }

                    if (!fileExists('style.css')) {
                        error('style.css is missing!')
                    } else {
                        echo 'style.css Found'
                    }

                    if (!fileExists('script.js')) {
                        error('script.js is missing!')
                    } else {
                        echo 'script.js Found'
                    }
                }
            } 
        } 
        stage('Create Build Artifact') { 
            steps { 
                echo 'Creating ZIP file...' 
                powershell 'Compress-Archive -Path * -DestinationPath StudentManagementSystem.zip -Force' 
            } 
        } 
        stage('Archive Build') { 
            steps { 
                archiveArtifacts artifacts: 'StudentManagementSystem.zip', fingerprint: true 
            } 
        } 
    } 

    post { 
        success { 
            echo 'Application Build Successful.' 
        } 
        failure { 
            echo 'Application Build Failed.' 
        } 
    } 
}
